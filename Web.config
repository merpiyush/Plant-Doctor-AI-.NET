<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- lets the ASP.NET validators work without jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <!-- DATABASE CONNECTION (SQL Server LocalDB comes with Visual Studio).
       Create the database first: run App_Data/Database.sql -->
  <connectionStrings>
    <add name="PlantDoctorDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=PlantDoctorDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
  </system.web>

</configuration>
